# Ejecutar con: cp .env.example .env y ajustar valores
# Solo .env.example se commitea. Nunca commitear .env real.

NODE_ENV=development
PORT=3100

# PokeAPI
POKEAPI_BASE=https://pokeapi.co/api/v2
POKEAPI_CACHE_TTL_S=86400

# Redis (servicio definido en docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Prisma / SQLite local (futura migración a Postgres)
# connection_limit=1 serializa las escrituras (SQLite admite un solo escritor).
# Tras la primera migración en dev, activar WAL una vez:
#   sqlite3 prisma/dev.db "PRAGMA journal_mode=WAL;"
DATABASE_URL="file:./dev.db?connection_limit=1"

# Autenticación (Better Auth)
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production
# En producción debe ser la URL pública (Tailscale Funnel), p. ej.
# https://<nodo>.<tailnet>.ts.net — de lo contrario los enlaces de
# verificación de email apuntarán a localhost.
BETTER_AUTH_URL=http://localhost:3100

# Email transaccional (Resend) — verificación obligatoria de cuentas
# Crear la API key en https://resend.com/api-keys y verificar el dominio remitente.
RESEND_API_KEY=
EMAIL_FROM="CompetiDex <no-reply@tudominio.com>"

# UI
NEXT_PUBLIC_APP_NAME=CompetiDex